{
  "name": "mini-tickets",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:types": "openapi-typescript ./contract/openapirest.yml -o ./src/api/generated/schema.d.ts",
    "api:check": "python ./backend/check_contract.py",
    "test:react": "vitest run",
    "test:python": "python -m pytest backend/tests -v",
    "test:all": "npm run test:react && npm run test:python && npm run api:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "backend": "python -m uvicorn app.main:app --app-dir backend --reload --host 127.0.0.1 --port 3001",
    "backend:test": "python -m pytest -q backend/tests"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "react-toastify": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.1.0"
  }
}